# Per-client-IP rate limit for the API gateway, replacing bearer-token auth
# as the abuse guard now that /api/* no longer requires a token. 10 MB zone
# (~160k tracked IPs), 10 req/s sustained with a burst of 20 before requests
# start getting rejected (429), not delayed (`nodelay`) -- decompile calls
# are CPU-heavy on the backend, so bursts should fail fast, not queue.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 5s;

    client_max_body_size 50m;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        set $fission_backend "${FISSION_BACKEND_HOST}:${FISSION_BACKEND_PORT}";
        proxy_pass http://$fission_backend;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
